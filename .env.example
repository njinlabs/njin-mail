# Single fixed IMAP/SMTP backend shared by all tenants. Multi-tenant domain
# enforcement happens per-request based on the Host header the browser used
# (e.g. mail.j3company.com -> only @j3company.com may log in), not on these
# values — see apps/server/src/lib/tenant.ts.
IMAP_HOST=mail.njin.run
IMAP_PORT=993
IMAP_SECURE=true
IMAP_REJECT_UNAUTHORIZED=true

SMTP_HOST=mail.njin.run
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REJECT_UNAUTHORIZED=true

# App
PORT=3001
DB_PATH=./data/njin-mail.sqlite
SYNC_INTERVAL_MS=60000

# Security — generate with: bun -e "console.log(crypto.randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
SESSION_SECRET=
