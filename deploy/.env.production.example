# Copy to /opt/njin-mail/.env on the server (chmod 600, owned by the njinmail user).
# Never commit a real .env — this is a template only.

# Single fixed IMAP/SMTP backend shared by all tenants (multi-tenant domain
# enforcement is based on each request's Host header, not on this value).
IMAP_HOST=mail.jadiweb.id
IMAP_PORT=993
IMAP_SECURE=true
IMAP_REJECT_UNAUTHORIZED=true

SMTP_HOST=mail.jadiweb.id
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REJECT_UNAUTHORIZED=true

# App
PORT=3001
DB_PATH=./data/njin-mail.sqlite
SYNC_INTERVAL_MS=60000
NODE_ENV=production

# Do NOT set DEV_TENANT_DOMAIN here — it bypasses tenant Host-header
# enforcement entirely and must only ever exist in local dev.

# Security — generate fresh values for production, never reuse dev's:
#   bun -e "console.log(crypto.randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=__GENERATE_ME__
SESSION_SECRET=__GENERATE_ME__
